{
  "name": "vajra-dhir-vscode",
  "displayName": "Vajra-Dhīr EDA",
  "description": "Deterministic Hardware + Software Co-Design IDE for VS Code & VSCodium",
  "version": "0.1.0",
  "publisher": "vajradhir",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCustomEditor:vajradhir.pcbEditor",
    "onCustomEditor:vajradhir.schematicEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vajradhir.pcbEditor",
        "displayName": "Vajra-Dhīr PCB Layout (WebGPU / WebGL2)",
        "selector": [
          {
            "filenamePattern": "*.kicad_pcb"
          },
          {
            "filenamePattern": "*.vd.db"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vajradhir.schematicEditor",
        "displayName": "Vajra-Dhīr Schematic Editor",
        "selector": [
          {
            "filenamePattern": "*.kicad_sch"
          },
          {
            "filenamePattern": "*.ato"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vajradhir.launchDoctor",
        "title": "Vajra-Dhīr: Run Diagnostics Preflight (vd doctor)"
      },
      {
        "command": "vajradhir.verifyDesign",
        "title": "Vajra-Dhīr: Run 9-Gate Verification"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "7.0.2"
  }
}
