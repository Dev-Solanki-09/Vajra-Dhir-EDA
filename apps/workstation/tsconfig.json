{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@tracespace/identify-layers": ["../../packages/tracespace-vendor/identify-layers/src/index.ts"],
      "@tracespace/parser": ["../../packages/tracespace-vendor/parser/src/index.ts"],
      "@tracespace/plotter": ["../../packages/tracespace-vendor/plotter/src/index.ts"],
      "moo": ["./src/shims/moo.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "../../vendor/**",
    "../../workers/**",
    "../../.vd-runtime/**",
    "../../.vd-portable/**",
    "../../.vd-cache/**",
    "../../.venv/**",
    "../../target/**",
    "../../.pnpm-store/**"
  ]
}
