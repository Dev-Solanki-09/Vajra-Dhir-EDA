{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vajra-Dhir Companion Pack Lock Schema v1",
  "type": "object",
  "required": ["schema_version", "generated_utc", "packs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_utc": { "type": "string" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack_id", "tier", "license_spdx", "commit_sha", "targets"],
        "properties": {
          "pack_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "tier": { "type": "integer", "enum": [1, 2] },
          "license_spdx": { "type": "string" },
          "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "corresponding_source_url": { "type": "string" },
          "targets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["url", "sha256", "size_bytes"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "size_bytes": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
