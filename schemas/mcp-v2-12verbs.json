{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-dhir.org/schemas/mcp-v2-12verbs.json",
  "title": "Vajra-Dhīr EDA Harness MCP v2 12-Verb Protocol Schema",
  "description": "Canonical 12-verb JSON-RPC tool schemas spanning P1..P17 across vd-mcp and vd-daemon (Wasmtime 51 Code Mode)",
  "type": "object",
  "required": ["version", "verbs"],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0.0"
    },
    "verbs": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "hw_discover",
              "hw_inspect",
              "hw_patch",
              "hw_lock",
              "hw_compile",
              "hw_verify",
              "hw_simulate",
              "hw_layout",
              "hw_signoff",
              "hw_firmware",
              "hw_export",
              "hw_diff"
            ]
          },
          "description": { "type": "string" },
          "inputSchema": { "type": "object" }
        }
      }
    }
  }
}
